<!--
    Design tokens for the panel chrome (screen spec docs/design/2026-08-29-screen-spec.md
    §1). Every colour lives in ResourceDictionary.ThemeDictionaries under Light/Dark, never
    as a bare literal a page could bake into content — that is the one thing responsible
    for the macOS defect where note text stayed black in dark mode and never switched live:
    colour was read once and stored, instead of resolved from the theme each time it is
    needed. Everything here is read via {ThemeResource ...}, never {StaticResource ...}, for
    every brush, so switching RequestedTheme on the root element re-resolves the whole tree.

    Spacing, radii, sizes and the type scale do not vary by theme, so they live as plain
    resources alongside the ThemeDictionaries rather than duplicated inside both.
-->
<ResourceDictionary
    x:Class="Notebar.App.DesignSystem.Tokens"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- §1.1 Color — Light appearance -->
            <SolidColorBrush x:Key="SurfaceRailBackgroundBrush" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="SurfacePanelBackgroundBrush" Color="#FBFBFD"/>
            <SolidColorBrush x:Key="SurfaceElevatedBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BorderSeparatorBrush" Color="#000000" Opacity="0.08"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73"/>
            <!-- Task 16 contrast fix (docs/superpowers/notes/2026-09-04-panel-contrast.md):
                 #A1A1A6 on #FBFBFD measured 2.49:1, failing even the 3:1 non-text floor.
                 #8E8E93 clears it (3.15:1). TextTertiaryBrush is restricted to icon glyphs
                 and other non-text graphics (see ChromeMicroTextStyle below, which no longer
                 uses it), so 3:1 is the bar that matters here, not 4.5:1. -->
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8E8E93"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FF9500"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#34C759"/>
            <!-- Task 16 — Settings -> Data's in-memory-database warning row (see SettingsTab).
                 A themed 12%-opacity tint of WarningBrush, the same pattern AccentHover08Brush
                 etc. use below, so the row's background stays legible in both appearances
                 without a second hardcoded color. -->
            <SolidColorBrush x:Key="WarningTint12Brush" Color="#FF9500" Opacity="0.12"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <!-- §1.2 Color — Dark appearance -->
            <SolidColorBrush x:Key="SurfaceRailBackgroundBrush" Color="#1E1E20"/>
            <SolidColorBrush x:Key="SurfacePanelBackgroundBrush" Color="#242426"/>
            <SolidColorBrush x:Key="SurfaceElevatedBackgroundBrush" Color="#2C2C2E"/>
            <SolidColorBrush x:Key="BorderSeparatorBrush" Color="#FFFFFF" Opacity="0.10"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#98989D"/>
            <!-- Dark's own #6E6E73 already measures 3.1:1 (screen spec §8) — clears the
                 same non-text floor without changing, so only the light value moves. -->
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E6E73"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#FF453A"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FF9F0A"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#30D158"/>
            <SolidColorBrush x:Key="WarningTint12Brush" Color="#FF9F0A" Opacity="0.12"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        Accent: always the live system accent colour, never a hardcoded hex — screen spec
        §1's rule for NSColor.controlAccentColor ("must always be read from ... never
        hardcoded"). SystemAccentColor is the WinUI/WinAppSDK equivalent, supplied by
        XamlControlsResources (merged in App.xaml) and already theme-aware on its own, so it
        needs no Light/Dark split here. The four tinted variants below use SolidColorBrush's
        own Opacity property (distinct from the Color's alpha channel) so each one repaints
        only itself, never dimming whatever sits inside the element it colors the way an
        element-level Opacity would.
    -->
    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="AccentHover04Brush" Color="{ThemeResource SystemAccentColor}" Opacity="0.04"/>
    <SolidColorBrush x:Key="AccentHover08Brush" Color="{ThemeResource SystemAccentColor}" Opacity="0.08"/>
    <SolidColorBrush x:Key="AccentSelected12Brush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12"/>
    <SolidColorBrush x:Key="AccentToggleOn10Brush" Color="{ThemeResource SystemAccentColor}" Opacity="0.10"/>

    <!-- §1.4 Spacing scale (space.*), 4pt base grid -->
    <x:Double x:Key="SpaceXxs">4</x:Double>
    <x:Double x:Key="SpaceXs">8</x:Double>
    <x:Double x:Key="SpaceSm">12</x:Double>
    <x:Double x:Key="SpaceMd">16</x:Double>
    <x:Double x:Key="SpaceLg">20</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="SpaceXxl">32</x:Double>

    <!-- §1.5 Corner radii (radius.*) -->
    <x:Double x:Key="RadiusSm">6</x:Double>
    <x:Double x:Key="RadiusMd">10</x:Double>
    <x:Double x:Key="RadiusLg">14</x:Double>
    <x:Double x:Key="RadiusPanel">12</x:Double>
    <CornerRadius x:Key="RadiusSmCornerRadius">6</CornerRadius>
    <!-- radius.md as a CornerRadius object — Task 14's task cards (screen spec §5.1). -->
    <CornerRadius x:Key="RadiusMdCornerRadius">10</CornerRadius>

    <!--
        radius.md applied to the collapsed handle's left corners only, square on the right
        (§2 "Collapsed handle" — the edge flush against the physical screen boundary is
        never rounded).
    -->
    <CornerRadius x:Key="HandleCornerRadius">10,0,0,10</CornerRadius>
    <!-- radius.panel applied to the panel's own left corners only (§2 "Corner treatment"). -->
    <CornerRadius x:Key="PanelCornerRadius">12,0,0,12</CornerRadius>

    <!-- §1.3 Chrome type scale (rail, tab strip, cards, headers, all non-editor UI) -->
    <Style x:Key="ChromeTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="ChromeBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="ChromeLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="LineHeight" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="ChromeCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LineHeight" Value="14"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
    </Style>
    <!-- Task 16 contrast fix: this is small (10pt) text — the rail's task-count badge and
         the all-notes menu timestamps — so it earns the text-tier contrast requirement, not
         the lighter one non-text graphics get. TextSecondaryBrush measures 4.91:1 (light) /
         5.40:1 (dark), both well clear of 4.5:1; TextTertiaryBrush would fail here even at
         its own corrected value. -->
    <Style x:Key="ChromeMicroTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
    </Style>

    <!--
        Chrome sizes the rail/toolbar/handle XAML reads directly. These are visual/layout
        sizes only. Anything that is also load-bearing for the window's own frame (handle
        width/height, the 340dip compact breakpoint, ...) lives in
        Notebar.Core.Panel.PanelTiming instead and must be read from there in code, never
        duplicated here as a second literal — see RootPage.
    -->
    <x:Double x:Key="RailWidth">56</x:Double>
    <x:Double x:Key="RailWidthCompact">44</x:Double>
    <x:Double x:Key="RailItemHeight">48</x:Double>
    <x:Double x:Key="RailItemHeightCompact">44</x:Double>
    <x:Double x:Key="ControlToggleSize">24</x:Double>
    <x:Double x:Key="ControlRowHeight">32</x:Double>
    <x:Double x:Key="ToolbarActionSize">28</x:Double>
    <x:Double x:Key="ToolbarHeight">36</x:Double>
    <!-- FormattingBarView's own Tokens.Size (Notebar/DesignSystem/Tokens.swift): the 32pt
         row beneath the tab toolbar and its 28pt buttons (screen spec §4.2). -->
    <x:Double x:Key="FormattingBarHeight">32</x:Double>
    <x:Double x:Key="FormattingBarButtonSize">28</x:Double>
    <x:Double x:Key="HairlineThickness">1</x:Double>
    <x:Double x:Key="RailIndicatorWidth">2.5</x:Double>
    <x:Double x:Key="RailIndicatorHeight">24</x:Double>
    <x:Double x:Key="RailIndicatorRadius">1.25</x:Double>

    <!--
        Margins tied to specific chrome rows, built from the spacing scale above rather than
        re-deriving a Thickness from a plain double at each use site (StaticResource needs an
        object of the target property's own type — a Thickness resource, not a double, for
        anything assigned to Margin/Padding). Screen spec §2 "Safe margins": space.xs (8pt)
        clearance before the first row of chrome and around each hairline, not space.md.
    -->
    <Thickness x:Key="ControlRowTopMargin">0,8,0,0</Thickness>
    <Thickness x:Key="RailHairlineMargin">8,8,8,8</Thickness>
    <Thickness x:Key="RailTabMargin">8,0,8,0</Thickness>
    <Thickness x:Key="CollapseButtonMargin">0,0,0,8</Thickness>
    <Thickness x:Key="ToolbarLeftContentMargin">16,0,12,0</Thickness>
    <Thickness x:Key="ToolbarRightContentMargin">0,0,16,0</Thickness>

    <!--
        Task 14 — the tasks board. space.sm (12pt) card padding per screen spec §5.1;
        space.xs (8pt) below each card so the next one clears it; a 6pt half-gutter either
        side of the 1px inter-column separator, which totals ~13pt of clearance between two
        cards in adjacent columns — the closest a fixed-Thickness resource gets to the
        spec's 12pt gutter figure without a third, single-purpose token.
    -->
    <Thickness x:Key="TaskCardPadding">12,12,12,12</Thickness>
    <Thickness x:Key="TaskCardMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TaskColumnSeparatorMargin">6,0,6,0</Thickness>
    <!-- Screen spec §5.1's "Drop a task here" empty-column placeholder is board-shaped
         chrome, not a fixed pixel value, so it stays a plain double rather than a second
         Thickness — see TasksTab.xaml's own remarks on why a MinHeight alone (not the
         dashed-outline caption) is what this task treats as load-bearing. -->
    <x:Double x:Key="TaskColumnMinHeight">120</x:Double>

    <!--
        Task 15 — linking (screen spec §4.2 "Mention popover", product spec §6.4). Width and
        max-height are the spec's own figures for the @ popover and the backlinks list.
        MentionAutocomplete and BacklinksSection are host-side XAML, not the WebView2
        document, precisely so they can read design tokens like every other chrome element
        instead of duplicating them as CSS literals.
    -->
    <x:Double x:Key="MentionPopoverWidth">260</x:Double>
    <x:Double x:Key="MentionPopoverMaxHeight">220</x:Double>
    <x:Double x:Key="BacklinksMaxHeight">96</x:Double>
    <Thickness x:Key="MentionRowPadding">16,12,16,12</Thickness>
    <Thickness x:Key="BacklinkRowPadding">16,8,16,8</Thickness>
    <Thickness x:Key="BacklinksHeaderPadding">16,12,16,4</Thickness>

    <!-- Task 16 — Settings (General/Activation/Data/About). Each section is a card:
         space.md (16pt) padding, space.sm (12pt) between its rows. -->
    <Thickness x:Key="SettingsSectionPadding">16,12,16,12</Thickness>
    <Thickness x:Key="SettingsPagePadding">16,16,16,20</Thickness>
</ResourceDictionary>
