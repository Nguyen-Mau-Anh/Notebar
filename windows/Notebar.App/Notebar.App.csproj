<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>Notebar.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <ApplicationIcon>Assets/Notebar.ico</ApplicationIcon>
    <!-- The LibraryImport source generator emits function-pointer marshalling
         for some P/Invoke signatures in NativeMethods.cs (e.g. out-parameter
         structs), which the compiler classifies as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Notebar.Core/Notebar.Core.csproj" />
    <!-- First needed by Task 10: NoteEditorHost calls Notebar.Store.NoteHtml
         to derive body_plain host-side, and later tasks open the database
         from here too. -->
    <ProjectReference Include="../Notebar.Store/Notebar.Store.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\**\*.png" />
    <!-- The note editor's guest half (HTML/CSS/JS) is static content served
         by NoteEditorHost through a virtual host mapping, not compiled code —
         it must land next to the exe at run time. -->
    <Content Include="Editor\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
