<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>Notebar.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- The publish step passes "self-contained true", but that only bundles the
         .NET runtime. The Windows App SDK runtime is a separate opt-in; without
         this, Notebar.App.exe fails to start on any machine that doesn't already
         have the Windows App SDK runtime installed, which is nearly all of them —
         silently, or with a missing-DLL dialog. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Task 16, task-1-report.md's Lead #1: WindowsPackageType=MSIX is not part of the
         standard WinUI single-project MSIX template (which relies on EnableMsixTooling=true
         alone) and is the one property, across 13 prior CI runs, whose presence correlated
         exactly with RuntimeIdentifier being silently ignored and package.map.txt coming out
         empty — honoured under WindowsPackageType=None (the portable-zip step, green every
         run) and ignored under MSIX regardless of how RuntimeIdentifier was supplied. Removed
         here as the one authorized attempt at unblocking MSIX packaging; if the CI run this
         lands in still doesn't produce an .msix, MSIX stays parked and the portable zip
         remains the release's primary artifact (see docs/release-notes-windows.md). -->
    <ApplicationIcon>Assets/Notebar.ico</ApplicationIcon>
    <!-- The LibraryImport source generator emits function-pointer marshalling
         for some P/Invoke signatures in NativeMethods.cs (e.g. out-parameter
         structs), which the compiler classifies as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Notebar.Core/Notebar.Core.csproj" />
    <!-- First needed by Task 10: NoteEditorHost calls Notebar.Store.NoteHtml
         to derive body_plain host-side, and later tasks open the database
         from here too. -->
    <ProjectReference Include="../Notebar.Store/Notebar.Store.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\**\*.png" />
    <!-- The note editor's guest half (HTML/CSS/JS) is static content served
         by NoteEditorHost through a virtual host mapping, not compiled code —
         it must land next to the exe at run time. -->
    <Content Include="Editor\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
