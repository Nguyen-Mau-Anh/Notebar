<UserControl
    x:Class="Notebar.App.Features.CollapsedHandle"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        What the panel shows at rest, flush to the right screen edge, once it has retreated
        instead of vanishing (screen spec §2 "Collapsed handle"). Drawn by the same window —
        PanelController simply resizes the window to this rect — so this control only needs
        to fill whatever frame it is given; it does not size or position itself.

        Centred inside it is the current tab's icon, so the user can see what they will get
        back. RootPage calls SetTab whenever PanelViewModel.Selection changes.
    -->
    <Border x:Name="Root" Background="{ThemeResource SurfaceElevatedBackgroundBrush}"
            CornerRadius="{StaticResource HandleCornerRadius}"
            PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
        <Grid>
            <FontIcon x:Name="IconOff" FontSize="18"
                      Foreground="{ThemeResource TextSecondaryBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <FontIcon x:Name="IconOn" FontSize="18"
                      Foreground="{ThemeResource AccentBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
