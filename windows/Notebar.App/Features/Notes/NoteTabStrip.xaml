<UserControl
    x:Class="Notebar.App.Features.Notes.NoteTabStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Notebar.App.Features.Notes">

    <!--
        The horizontal, Notepad++-style tab strip (screen spec §4.1) that fills the Notes
        toolbar's left slot. Per tab: min-width 96, max-width 160, tail-truncated title.

        The close glyph sits BEFORE the title, never after — on the macOS build it used to
        trail the label, sitting exactly where the next tab's own title begins, and got
        mis-clicked constantly. Every tab here reads "x Title" for exactly that reason.

        NoteTabItem (Id/DisplayTitle/IsActive/IsInactive) is a per-render projection built
        fresh by Rebuild() below, not Note itself — Note carries no notion of "is this tab
        active". Hover is not part of that projection at all: it is transient pointer state,
        handled entirely in code-behind via FindName on the realized container, the same
        show/hide-a-pre-declared-element pattern TabRail and CollapsedHandle use everywhere
        else in this codebase (no brush is ever assigned from code here, only Visibility).
    -->
    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="TabsList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:NoteTabItem">
                    <Grid MinWidth="96" MaxWidth="160" Padding="8,6,8,6"
                          Background="Transparent"
                          CornerRadius="{StaticResource RadiusSmCornerRadius}"
                          Tapped="OnTabTapped"
                          PointerEntered="OnTabPointerEntered" PointerExited="OnTabPointerExited">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ActiveBg" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="{ThemeResource AccentSelected12Brush}"
                                CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Visibility="{x:Bind IsActive}"/>
                        <Border x:Name="HoverBg" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="{ThemeResource AccentHover04Brush}"
                                CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Visibility="Collapsed"/>

                        <!-- Visible on hover or while active — the Visibility set here is
                             only the INITIAL value; OnTabPointerEntered/Exited below own it
                             afterwards. 24x24 hit target per screen spec §4.1 ("Close:
                             xmark, 10pt glyph in a 24×24 hit target"), which is exactly
                             ControlToggleSize. -->
                        <Button x:Name="CloseButton" Grid.Column="0"
                                Width="{StaticResource ControlToggleSize}"
                                Height="{StaticResource ControlToggleSize}" Padding="0"
                                Margin="0,0,4,0" BorderThickness="0" Background="Transparent"
                                Visibility="{x:Bind IsActive}"
                                Click="OnCloseButtonClick"
                                AutomationProperties.Name="Close note">
                            <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        </Button>

                        <TextBlock x:Name="TitleOff" Grid.Column="1" Text="{x:Bind DisplayTitle}"
                                   Style="{StaticResource ChromeBodyTextStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Visibility="{x:Bind IsInactive}"
                                   DoubleTapped="OnTitleDoubleTapped"/>
                        <TextBlock x:Name="TitleOn" Grid.Column="1" Text="{x:Bind DisplayTitle}"
                                   Style="{StaticResource ChromeBodyTextStyle}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Visibility="{x:Bind IsActive}"
                                   DoubleTapped="OnTitleDoubleTapped"/>

                        <Border x:Name="ActiveUnderline" Grid.Column="0" Grid.ColumnSpan="2" Height="2"
                                VerticalAlignment="Bottom" Background="{ThemeResource AccentBrush}"
                                Visibility="{x:Bind IsActive}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
