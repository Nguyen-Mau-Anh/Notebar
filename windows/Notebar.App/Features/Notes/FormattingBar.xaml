<UserControl
    x:Class="Notebar.App.Features.Notes.FormattingBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The 32pt formatting row directly beneath the tab toolbar (screen spec §4.2, and the
        macOS build's FormattingBarView) — eight controls, left to right: Bold, Italic, Code,
        H1, H2, Bulleted list, Numbered list, Checklist. NotesTab shows and hides this whole
        control depending on whether a note is open; this view always draws the full bar
        whenever it is placed, the same split FormattingBarView.swift uses.

        Text glyphs (B, I, "&lt;/&gt;", H1, H2, •, 1., "[ ]"/"[x]") rather than FontIcon
        codepoints — deliberately all-ASCII, not from a shortage of Segoe Fluent Icons. This
        runs on Windows only, which this repo cannot build or render, so an icon-font glyph
        that happens not to exist in the installed font would ship silently blank the same
        way six SF Symbol glyphs once did on macOS (see the task's defect table) — and a
        pictograph like "☑" carries exactly that risk even from a font as common as Segoe UI
        Symbol, since it sits in the same Unicode block as "☐", one of the six that actually
        shipped invisible there. Every character in this set is plain ASCII and depends on no
        font's glyph coverage at all — not "probably covered by fallback," genuinely
        guaranteed. The checklist button's own "[ ]"/"[x]" pair doubles as a legend for the
        "[] " markdown shortcut (editor.js) that creates the same thing. CollapseButton
        (Features/TabRail.xaml) already sets the plain-character precedent for the same
        reason; do not "improve" any of these back into a pictograph or an icon-font glyph.

        Below the compact breakpoint the bar scrolls horizontally rather than wrapping to a
        second row (macOS parity, FormattingBarView.swift's own ScrollView(.horizontal)) — a
        fixed height on the ScrollViewer itself is what keeps the chrome from growing taller
        as the panel narrows.

        Every button follows TabRail's own two rules: an explicit Background="Transparent"
        on every clickable cell (a null background only hit-tests its glyph, not its full tap
        target — the defect that made rail tabs need "a few clicks" once), and every colour a
        static {ThemeResource ...} reference that FormattingBar.xaml.cs only ever shows or
        hides, never assigns.
    -->
    <StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Height="{StaticResource FormattingBarHeight}"
                      Background="{ThemeResource SurfacePanelBackgroundBrush}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}"
                        Padding="{StaticResource ToolbarLeftContentMargin}"
                        VerticalAlignment="Center">

                <!-- Bold -->
                <Button x:Name="BoldButton" Width="{StaticResource FormattingBarButtonSize}"
                        Height="{StaticResource FormattingBarButtonSize}" Padding="0"
                        BorderThickness="0" Background="Transparent"
                        CornerRadius="{StaticResource RadiusSmCornerRadius}"
                        AutomationProperties.Name="Bold">
                    <Grid>
                        <Border x:Name="BoldHoverBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentHover08Brush}" Visibility="Collapsed"/>
                        <Border x:Name="BoldActiveBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentSelected12Brush}" Visibility="Collapsed"/>
                        <TextBlock x:Name="BoldTextOff" Text="B" FontSize="15" FontWeight="Bold"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BoldTextOn" Text="B" FontSize="15" FontWeight="Bold"
                                   Foreground="{ThemeResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <!-- Italic -->
                <Button x:Name="ItalicButton" Width="{StaticResource FormattingBarButtonSize}"
                        Height="{StaticResource FormattingBarButtonSize}" Padding="0"
                        BorderThickness="0" Background="Transparent"
                        CornerRadius="{StaticResource RadiusSmCornerRadius}"
                        AutomationProperties.Name="Italic">
                    <Grid>
                        <Border x:Name="ItalicHoverBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentHover08Brush}" Visibility="Collapsed"/>
                        <Border x:Name="ItalicActiveBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentSelected12Brush}" Visibility="Collapsed"/>
                        <TextBlock x:Name="ItalicTextOff" Text="I" FontSize="15" FontStyle="Italic"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ItalicTextOn" Text="I" FontSize="15" FontStyle="Italic"
                                   Foreground="{ThemeResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <!-- Code (formatBlock "<pre>") -->
                <Button x:Name="CodeButton" Width="{StaticResource FormattingBarButtonSize}"
                        Height="{StaticResource FormattingBarButtonSize}" Padding="0"
                        BorderThickness="0" Background="Transparent"
                        CornerRadius="{StaticResource RadiusSmCornerRadius}"
                        AutomationProperties.Name="Code">
                    <Grid>
                        <Border x:Name="CodeHoverBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentHover08Brush}" Visibility="Collapsed"/>
                        <Border x:Name="CodeActiveBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentSelected12Brush}" Visibility="Collapsed"/>
                        <TextBlock x:Name="CodeTextOff" Text="&lt;/&gt;" FontSize="11" FontWeight="SemiBold"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CodeTextOn" Text="&lt;/&gt;" FontSize="11" FontWeight="SemiBold"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   Foreground="{ThemeResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <!-- H1 (formatBlock "<h1>") -->
                <Button x:Name="H1Button" Width="{StaticResource FormattingBarButtonSize}"
                        Height="{StaticResource FormattingBarButtonSize}" Padding="0"
                        BorderThickness="0" Background="Transparent"
                        CornerRadius="{StaticResource RadiusSmCornerRadius}"
                        AutomationProperties.Name="Heading 1">
                    <Grid>
                        <Border x:Name="H1HoverBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentHover08Brush}" Visibility="Collapsed"/>
                        <Border x:Name="H1ActiveBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentSelected12Brush}" Visibility="Collapsed"/>
                        <TextBlock x:Name="H1TextOff" Text="H1" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="H1TextOn" Text="H1" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <!-- H2 (formatBlock "<h2>") -->
                <Button x:Name="H2Button" Width="{StaticResource FormattingBarButtonSize}"
                        Height="{StaticResource FormattingBarButtonSize}" Padding="0"
                        BorderThickness="0" Background="Transparent"
                        CornerRadius="{StaticResource RadiusSmCornerRadius}"
                        AutomationProperties.Name="Heading 2">
                    <Grid>
                        <Border x:Name="H2HoverBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentHover08Brush}" Visibility="Collapsed"/>
                        <Border x:Name="H2ActiveBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentSelected12Brush}" Visibility="Collapsed"/>
                        <TextBlock x:Name="H2TextOff" Text="H2" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="H2TextOn" Text="H2" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <!-- Bulleted list (insertUnorderedList) -->
                <Button x:Name="BulletButton" Width="{StaticResource FormattingBarButtonSize}"
                        Height="{StaticResource FormattingBarButtonSize}" Padding="0"
                        BorderThickness="0" Background="Transparent"
                        CornerRadius="{StaticResource RadiusSmCornerRadius}"
                        AutomationProperties.Name="Bulleted list">
                    <Grid>
                        <Border x:Name="BulletHoverBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentHover08Brush}" Visibility="Collapsed"/>
                        <Border x:Name="BulletActiveBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentSelected12Brush}" Visibility="Collapsed"/>
                        <TextBlock x:Name="BulletTextOff" Text="&#x2022;" FontSize="20" FontWeight="Bold"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BulletTextOn" Text="&#x2022;" FontSize="20" FontWeight="Bold"
                                   Foreground="{ThemeResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <!-- Numbered list (insertOrderedList) -->
                <Button x:Name="NumberButton" Width="{StaticResource FormattingBarButtonSize}"
                        Height="{StaticResource FormattingBarButtonSize}" Padding="0"
                        BorderThickness="0" Background="Transparent"
                        CornerRadius="{StaticResource RadiusSmCornerRadius}"
                        AutomationProperties.Name="Numbered list">
                    <Grid>
                        <Border x:Name="NumberHoverBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentHover08Brush}" Visibility="Collapsed"/>
                        <Border x:Name="NumberActiveBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentSelected12Brush}" Visibility="Collapsed"/>
                        <TextBlock x:Name="NumberTextOff" Text="1." FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NumberTextOn" Text="1." FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <!-- Checklist (insertHTML, no execCommand equivalent exists) -->
                <Button x:Name="ChecklistButton" Width="{StaticResource FormattingBarButtonSize}"
                        Height="{StaticResource FormattingBarButtonSize}" Padding="0"
                        BorderThickness="0" Background="Transparent"
                        CornerRadius="{StaticResource RadiusSmCornerRadius}"
                        AutomationProperties.Name="Checklist">
                    <Grid>
                        <Border x:Name="ChecklistHoverBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentHover08Brush}" Visibility="Collapsed"/>
                        <Border x:Name="ChecklistActiveBg" CornerRadius="{StaticResource RadiusSmCornerRadius}"
                                Background="{ThemeResource AccentSelected12Brush}" Visibility="Collapsed"/>
                        <!-- "[ ]"/"[x]", not a pictograph: a checkbox glyph like "☑" is the
                             one character that would break this bar's all-ASCII scheme, and
                             it is also the one carrying real font risk (see the file-level
                             remarks above). Plain brackets need no font's glyph coverage, and
                             the pair doubles as a legend for the "[] " markdown shortcut that
                             creates the same checklist item. -->
                        <TextBlock x:Name="ChecklistTextOff" Text="[ ]" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ChecklistTextOn" Text="[x]" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Button>

            </StackPanel>
        </ScrollViewer>
        <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource BorderSeparatorBrush}"/>
    </StackPanel>
</UserControl>
