<UserControl
    x:Class="Notebar.App.Features.Notes.AllNotesMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Notebar.App.Features.Notes">

    <!--
        The all-notes menu's content, hosted in a Flyout by NotesTab (screen spec §6.2a):
        every note in the database, most recently updated first — not just the ones with
        open tabs, so a note whose tab was closed still has a route back into the strip. See
        NotesViewModel.AllNotesByRecency, which is built from INoteRepository.Summaries(),
        never All() — twenty notes with one screenshot each would otherwise mean reading
        megabytes to draw a list of names.

        NotesTab owns opening/closing the Flyout itself and setting
        PanelController.HasOpenOverlay while it is open — this control only ever renders
        AllNotesRowItem rows and raises NoteSelected.
    -->
    <Grid Width="260">
        <TextBlock x:Name="EmptyLabel" Text="No notes yet"
                   Style="{StaticResource ChromeCaptionTextStyle}"
                   Foreground="{ThemeResource TextSecondaryBrush}"
                   Padding="16" Visibility="Collapsed"/>

        <ScrollViewer x:Name="ListScroller" MaxHeight="320">
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:AllNotesRowItem">
                        <Button Background="Transparent" BorderThickness="0" Padding="12,8,12,8"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="OnRowClick">
                            <Grid ColumnSpacing="{StaticResource SpaceXs}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- A small accent dot ahead of the title for a note that
                                     already has an open tab. -->
                                <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{ThemeResource AccentBrush}"
                                         Visibility="{x:Bind IsOpen}"/>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayTitle}"
                                               Style="{StaticResource ChromeBodyTextStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind RelativeTime}"
                                               Style="{StaticResource ChromeMicroTextStyle}"
                                               Foreground="{ThemeResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
