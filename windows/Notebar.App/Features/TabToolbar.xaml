<UserControl
    x:Class="Notebar.App.Features.TabToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The 36pt toolbar row every content tab opens with (screen spec §2 "Tab toolbar"):
        context on the left, primary action on the right, a hairline beneath. The shape is
        fixed across tabs — RootPage supplies different LeftContent/RightContent per tab,
        never a different layout, so the primary action is always in the same place.
    -->
    <StackPanel>
        <Grid Height="{StaticResource ToolbarHeight}" Background="{ThemeResource SurfacePanelBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ContentPresenter Grid.Column="0" Content="{x:Bind LeftContent, Mode=OneWay}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Margin="{StaticResource ToolbarLeftContentMargin}"/>
            <ContentPresenter Grid.Column="1" Content="{x:Bind RightContent, Mode=OneWay}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="{StaticResource ToolbarRightContentMargin}"/>
        </Grid>
        <Border Height="{StaticResource HairlineThickness}" Background="{ThemeResource BorderSeparatorBrush}"/>
    </StackPanel>
</UserControl>
